<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>foot_switch</name>
  <version>0.0.0</version>
  <description>Foot switch node for teleoperation start, stop, bringup, and hand freeze commands</description>
  <maintainer email="kejia.chen@tum.de">tp2</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-evdev</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
